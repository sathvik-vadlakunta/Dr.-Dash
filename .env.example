# Database
DATABASE_URL="postgresql://drdash:drdash@localhost:5432/drdash?schema=public"

# FRED API. Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=""

# 32+ char random string. Generate: openssl rand -base64 48
SESSION_SECRET=""

# Shared secret required by POST /api/v1/admin/sync when called by a scheduler
CRON_SECRET=""

# Public base URL, used to build published dashboard links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: seed demo users and demo course in development
SEED_DEMO_DATA="true"

# Optional overrides
FRED_MAX_REQUESTS_PER_MINUTE="110"
FRED_REQUEST_TIMEOUT_MS="20000"
SYNC_CONCURRENCY="4"
